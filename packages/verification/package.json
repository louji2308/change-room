{
  "name": "@change-room/verification",
  "version": "0.1.0",
  "description": "Change Room Prediction vs Reality engine — compares a plan's predicted outcome against the actual outcome after execution and classifies the deviation (HEALTHY / DEGRADED / REGRESSION / UNKNOWN).",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "@change-room/domain": "workspace:*",
    "@change-room/simulator": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^17.0.21",
    "typescript": "^5.1.0"
  }
}